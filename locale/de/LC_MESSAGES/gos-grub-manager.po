msgid " (not included)"
msgstr " (nicht eingebunden)"

#: app.py:135
msgid " (new)"
msgstr " (neu)"

#: app.py:156
msgid "Order changed; not saved yet."
msgstr "Reihenfolge geändert; noch nicht gespeichert."

#: app.py:161
msgid "The selected file is no longer in the list."
msgstr "Die ausgewählte Datei ist nicht mehr in der Liste."

#: app.py:165
msgid "This file has not been saved yet and cannot be opened."
msgstr "Diese Datei ist noch nicht gespeichert und kann nicht geöffnet werden."

#: app.py:168
#, python-brace-format
msgid "Invalid filename: {name}"
msgstr "Ungültiger Dateiname: {name}"

#: app.py:173
#, python-brace-format
msgid "File is missing or is a symbolic link: {name}"
msgstr "Datei fehlt oder ist ein symbolischer Link: {name}"

#: app.py:178
msgid "No unprivileged user is available."
msgstr "Kein unprivilegierter Benutzer verfügbar."

#: app.py:181
#, python-brace-format
msgid "Cannot launch editor: {error}"
msgstr "Editor kann nicht gestartet werden: {error}"

#: app.py:193
msgid "Opening editor..."
msgstr "Editor wird geöffnet ..."

#: app.py:205
msgid "The editor could not be launched."
msgstr "Der Editor konnte nicht gestartet werden."

#: app.py:207
#, python-brace-format
msgid "Could not open editor: {error}"
msgstr "Editor konnte nicht geöffnet werden: {error}"

#: app.py:209
msgid "File passed to the default editor."
msgstr "Datei an den Standardeditor übergeben."

#: app.py:221
msgid "Searching; unmounted filesystems are temporarily mounted..."
msgstr "Suche läuft; nicht eingehängte Dateisysteme werden temporär eingehängt ..."

#: app.py:235
#, python-brace-format
msgid "Search failed: {error}"
msgstr "Suche fehlgeschlagen: {error}"

#: app.py:252
#, python-brace-format
msgid ""
"{name} — {device}:/{location}\n"
"  {count} boot entry → {filename}\n"
"\n"
"{content}"
msgid_plural ""
"{name} — {device}:/{location}\n"
"  {count} boot entries → {filename}\n"
"\n"
"{content}"
msgstr[0] ""
"{name} — {device}:/{location}\n"
"  {count} Boot-Eintrag → {filename}\n"
"\n"
